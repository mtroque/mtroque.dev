---
import { getProfile, getUi } from '../lib/content';
interface Props {
  /** On the home page the name is the h1 just below, so the header shows only the nav. */
  home?: boolean;
}
const { home = false } = Astro.props;
const [profile, ui] = await Promise.all([getProfile(), getUi()]);
---
<a class="skip-link" href="#main">{ui.skipLink}</a>
<header class="site-header">
  <div class="page site-header__inner">
    {!home && <a class="site-header__home" href="/">{profile.name}</a>}
    <nav aria-label={ui.navLabel}>
      <ul class="site-header__nav">{ui.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -10rem;
    z-index: 10;
    padding: var(--space-2) var(--space-3);
    background: var(--paper);
    border: 1px solid var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .skip-link:focus { top: var(--space-2); }

  .site-header { border-bottom: var(--hairline); }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
  }
  .site-header__home { color: var(--ink); font-weight: 500; text-decoration: none; }
  .site-header__home:hover { text-decoration: underline; }
  .site-header__nav {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }
  .site-header__nav a {
    display: inline-block;
    padding-block: var(--space-1); /* ~29px tall: above the 24px minimum target size */
    color: var(--ink-muted);
    text-decoration: none;
  }
  .site-header__nav a:hover { color: var(--accent); text-decoration: underline; }
  @media (min-width: 64rem) {
    /* Align the nav with the text column on the home page. */
    .site-header__inner { justify-content: flex-start; column-gap: var(--gutter); }
    .site-header__home { width: var(--rail); }
    nav { margin-left: auto; }
  }
</style>
