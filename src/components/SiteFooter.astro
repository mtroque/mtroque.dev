---
import { getProfile } from '../lib/content';
const profile = await getProfile();
// No year: a build-time year goes stale between deploys (decided 2026-11-24).
---
<footer class="site-footer">
  <div class="site-footer__inner mono muted">
    <p>© {profile.name}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: var(--hairline); margin-top: var(--space-12); }
  .site-footer__inner { padding-block: var(--space-6) var(--space-8); }
</style>
