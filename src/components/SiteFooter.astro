---
import { getProfile } from '../lib/content';
const profile = await getProfile();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="page site-footer__inner mono muted">
    <p>© {year} {profile.name}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: var(--hairline); margin-top: var(--space-12); }
  .site-footer__inner { padding-block: var(--space-6) var(--space-8); }
</style>
