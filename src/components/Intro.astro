---
import { getProfile } from '../lib/content';
import { inline } from '../lib/format';

const profile = await getProfile();
---
<section class="record intro" id="intro" aria-label={profile.name}>
  <div class="record__body">
    <p class="intro__headline">{profile.headline}</p>
    <div class="intro__bio">
      {profile.bio.map((p) => <p set:html={inline(p)} />)}
    </div>
  </div>
</section>

<style>
  .intro { padding-block-start: var(--space-8); }
  @media (min-width: 64rem) {
    /* First line's cap height level with the sidebar name. */
    .intro { padding-block-start: 2.75rem; }
  }
  .intro__headline {
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  @media (min-width: 64rem) {
    .intro__headline { text-wrap: balance; }
  }
  .intro__bio { margin-top: var(--space-8); }
  .intro__bio p + p { margin-top: var(--space-4); }

</style>
