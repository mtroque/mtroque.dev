---
import type { CollectionEntry } from 'astro:content';
import { getUi } from '../lib/content';
import { formatRange } from '../lib/format';
import MarginNote from './MarginNote.astro';
interface Props { org: CollectionEntry<'experience'> }
const { data } = Astro.props.org;
const ui = await getUi();
---
<article class="org">
  <h3 class="org__name">{data.org}</h3>
  <MarginNote>{formatRange(data.start, data.end, ui.present)}<br />{data.location}</MarginNote>
  <p class="org__role">{data.role}</p>
  {data.note && <p class="org__note muted">{data.note}</p>}
  <ul class="org__entries">
    {data.entries.map((e) => (
      <li class="entry">
        {e.href ? (
          <p><strong>{e.title}:</strong> <a href={e.href}>{e.body}</a></p>
        ) : (
          <>
            <p class="entry__head">
              <strong>{e.title}</strong>
              {e.qualifier && <span class="entry__qualifier mono muted">{e.qualifier}</span>}
            </p>
            {e.body && <p class="entry__body">{e.body}</p>}
          </>
        )}
      </li>
    ))}
  </ul>
</article>

<style>
  .org + .org { margin-top: var(--space-12); }
  .org__name { font-size: var(--step-1); }
  .org__role { margin-top: var(--space-1); }
  .org__note { margin-top: var(--space-2); }
  .org__entries {
    list-style: none;
    padding: 0 0 0 var(--space-4);
    margin-top: var(--space-6);
    border-left: var(--hairline);
  }
  .entry + .entry { margin-top: var(--space-6); }
  .entry__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-3);
  }
  .entry__body { margin-top: var(--space-1); }
</style>
