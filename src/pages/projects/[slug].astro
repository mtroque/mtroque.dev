---
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Media from '../../components/Media.astro';
import StatusStamp from '../../components/StatusStamp.astro';
import { getProfile, getProjects, getUi, type Project } from '../../lib/content';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props { project: Project }
const { project } = Astro.props;
const { data } = project;
const [{ Content, headings }, ui, profile] = await Promise.all([render(project), getUi(), getProfile()]);
const sections = headings.filter((h) => h.depth === 2);
---
<Shell
  title={`${data.title} · ${profile.name}`}
  description={data.description}
  ogImage={`/og/${project.id}.png`}
  nav={sections.map((h) => ({ label: h.text, href: `#${h.slug}` }))}
  navLabel={ui.tocLabel}
  back={{ label: ui.backHome, href: '/' }}
>
    <article class="case">
      <header class="record case__head">
        <div class="record__body">
          <h1 class="case__title">{data.title}</h1>
          <p class="case__tagline">{data.tagline}</p>
          {data.status === 'in-development' && <p class="case__stamp"><StatusStamp text={ui.projectStatus['in-development']} /></p>}
          <p class="case__lede">{data.blurb}</p>
        </div>
        <aside class="record__margin case__meta">
          <ul class="case__links mono">
            {data.links.live && <li><a href={data.links.live} rel="noopener">{ui.projectLinks.live}</a></li>}
            {data.links.source && <li><a href={data.links.source} rel="noopener">{ui.projectLinks.source}</a></li>}
          </ul>
          {data.stack.length > 0 && (
            <ul class="case__stack mono muted">{data.stack.map((s) => <li>{s}</li>)}</ul>
          )}
        </aside>
      </header>

      <div class="record case__main">
        <div class="record__body prose">
          <Content components={{ Media }} />
        </div>
      </div>
    </article>
</Shell>

<style>
  .case__head { padding-block: var(--space-8) var(--space-8); }
  @media (min-width: 64rem) {
    /* Title's cap height level with the sidebar name. */
    .case__head { padding-block-start: 2.75rem; }
  }
  .case__title { font-size: var(--step-3); font-weight: 600; line-height: 1.1; letter-spacing: -0.01em; }
  .case__tagline { margin-top: var(--space-2); font-size: var(--step-1); line-height: 1.35; color: var(--ink-muted); }
  .case__stamp { margin-top: var(--space-4); }
  .case__lede { margin-top: var(--space-6); }
  .case__links, .case__stack { list-style: none; padding: 0; }
  .case__links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-4); }
  .case__links a { display: inline-block; padding-block: var(--space-1); }
  .case__stack { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: 0 var(--space-4); line-height: 1.7; }

  .case__main { border-top: var(--hairline); padding-top: var(--space-8); }

  @media (min-width: 80rem) {
    .case__meta { padding-top: var(--space-2); border-left: var(--hairline); padding-left: var(--space-4); }
    .case__links { flex-direction: column; gap: var(--space-1); margin-top: 0; }
    .case__stack { flex-direction: column; margin-top: var(--space-4); line-height: 1.6; }
  }
</style>
